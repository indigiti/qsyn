; QSYN Upstox V3 private source — operator approval required.
; Do NOT deploy as-is. This file does not provision Cloudways Supervisor.
; One isolated Unix user, 0700 storage root, 0600 files per account/tenant.
; Verify real app OAuth consent, licensed CE+PE retention/display rights,
; current listed BOD strike+expiry, TLS access and WSS reverse proxy.
[program:qsyn-upstox-v3-ACCOUNT_A]
command=/ABSOLUTE/PRIVATE/app/bin/qsyn-upstox-worker run /ABSOLUTE/PRIVATE/config/worker-plan.json
directory=/ABSOLUTE/PRIVATE/app
user=ACCOUNT_UNIX_OWNER
autostart=false
autorestart=unexpected
exitcodes=0
startsecs=5
startretries=3
stopsignal=TERM
stopwaitsecs=35
stopasgroup=true
killasgroup=true
redirect_stderr=true
stdout_logfile=/ABSOLUTE/PRIVATE/logs/v3-worker-A.log
stdout_logfile_maxbytes=10MB
stdout_logfile_backups=5
environment=QSYN_UPSTOX_WORKER_ENABLE="1",QSYN_TRADING_ENABLED="0",QSYN_ENABLE_LIVE_TRADING="0"

; Independent viewer-specific chart service; must be loopback only.
; Requires a separately verified authenticated TLS WSS ingress.
[program:qsyn-upstox-v3-chart-ACCOUNT_A]
command=/ABSOLUTE/PRIVATE/app/bin/qsyn-private-chart serve 10445 /ABSOLUTE/PRIVATE/charts/upstox-A.ipc
directory=/ABSOLUTE/PRIVATE/app
user=ACCOUNT_UNIX_OWNER
autostart=false
autorestart=unexpected
exitcodes=0
startsecs=5
startretries=3
stopsignal=TERM
stopwaitsecs=15
redirect_stderr=true
stdout_logfile=/ABSOLUTE/PRIVATE/logs/v3-chart-A.log
stdout_logfile_maxbytes=10MB
stdout_logfile_backups=5
environment=QSYN_PRIVATE_CHART_GATEWAY_ENABLED="1",QSYN_PRIVATE_CHART_RIGHTS_FILE="/ABSOLUTE/PRIVATE/config/chart-rights.json",QSYN_PRIVATE_CHART_SIGNING_KEY_FILE="/ABSOLUTE/PRIVATE/config/chart-signing.key",QSYN_TRADING_ENABLED="0",QSYN_ENABLE_LIVE_TRADING="0"

; qsny-upstox-history intentionally omitted: it is a one-shot
; operator-only CLI import, NEVER a continuously running worker.


; Independently permissioned, READ ONLY historical candle reader.
; Reverse proxy ONLY /qsyn/private-chart/history to loopback 127.0.0.1:10446.
; Preserve Authorization header and reject cross-origin requests at ingress.
; Never make the raw port public; route disabled until private user auth
; and live account entitlements are independently audited.
[program:qsyn-upstox-v3-history-ACCOUNT_A]
command=/ABSOLUTE/PRIVATE/app/bin/qsyn-private-history serve /ABSOLUTE/PRIVATE/config/worker-plan.json /ABSOLUTE/PRIVATE/config/chart-signing.key /ABSOLUTE/PRIVATE/history 10446
directory=/ABSOLUTE/PRIVATE/app
user=ACCOUNT_UNIX_OWNER
autostart=false
autorestart=unexpected
exitcodes=0
startsecs=5
startretries=3
stopsignal=TERM
stopwaitsecs=15
stopasgroup=true
killasgroup=true
redirect_stderr=true
stdout_logfile=/ABSOLUTE/PRIVATE/logs/v3-history-A.log
stdout_logfile_maxbytes=10MB
stdout_logfile_backups=5
environment=QSYN_PRIVATE_HISTORY_HTTP_ENABLED="1",QSYN_TRADING_ENABLED="0",QSYN_ENABLE_LIVE_TRADING="0"


; QSYN native Upstox NSE/BSE INDEX subscriber; independent of the CE/PE worker.
; Operator must approve real current-BOD index mapping and separate display
; AND retention rights; a stored OAuth token or a green app profile alone is
; NOT enough. This is an executable example, never auto-started by DigiOps.
[program:qsyn-upstox-v3-index-ACCOUNT_A]
command=/ABSOLUTE/PRIVATE/app/bin/qsyn-upstox-index-worker run /ABSOLUTE/PRIVATE/config/index-worker-plan.json
directory=/ABSOLUTE/PRIVATE/app
user=ACCOUNT_UNIX_OWNER
autostart=false
autorestart=unexpected
exitcodes=0
startsecs=5
startretries=3
stopsignal=TERM
stopwaitsecs=35
stopasgroup=true
killasgroup=true
redirect_stderr=true
stdout_logfile=/ABSOLUTE/PRIVATE/logs/v3-index-worker-A.log
stdout_logfile_maxbytes=10MB
stdout_logfile_backups=5
environment=QSYN_UPSTOX_INDEX_WORKER_ENABLE="0",QSYN_TRADING_ENABLED="0",QSYN_ENABLE_LIVE_TRADING="0"

; IMPORTANT: Supervisor service activation requires a separate host-operator
; change of QSYN_UPSTOX_INDEX_WORKER_ENABLE to "1" AFTER provisioning 0700
; folders, 0600 files, approved BOD keys, exchange licenses and private
; authenticated TLS WebSocket chart ingress. No public listener or orders.

; Optional, independent NSE/BSE historical index reader. Never auto-start.
; The Cloudways private ingress MUST authenticate the requesting user before
; proxying ONLY /qsyn/private-chart/index-history to 127.0.0.1:10447.
; Do not expose the loopback port or use this for anonymous chart requests.
[program:qsyn-upstox-v3-index-history-ACCOUNT_A]
command=/ABSOLUTE/PRIVATE/app/bin/qsyn-private-index-history serve /ABSOLUTE/PRIVATE/config/index-worker-plan.json /ABSOLUTE/PRIVATE/config/chart-signing.key /ABSOLUTE/PRIVATE/index-history 10447
directory=/ABSOLUTE/PRIVATE/app
user=ACCOUNT_UNIX_OWNER
autostart=false
autorestart=true
startsecs=5
startretries=3
stopsignal=TERM
stopasgroup=true
killasgroup=true
redirect_stderr=true
stdout_logfile=/ABSOLUTE/PRIVATE/logs/v3-index-history-A.log
stdout_logfile_maxbytes=10MB
stdout_logfile_backups=5
environment=QSYN_PRIVATE_INDEX_HISTORY_HTTP_ENABLED="0",QSYN_TRADING_ENABLED="0",QSYN_ENABLE_LIVE_TRADING="0"

; Operator-only importer is deliberately NOT supervised or auto-started.
; qsyn-upstox-index-history check|backfill PLAN ARCHIVE "NSE_INDEX|Nifty 50" YYYY-MM-DD
; Backfill requires QSYN_UPSTOX_INDEX_HISTORY_ENABLE=1 and current BOD/rights.
